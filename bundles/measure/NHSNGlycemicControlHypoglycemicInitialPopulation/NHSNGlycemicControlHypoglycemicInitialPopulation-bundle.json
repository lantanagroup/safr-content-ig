    "resource": {
      "resourceType": "Measure",
      "id": "NHSNGlycemicControlHypoglycemicInitialPopulation",
      "meta": {
        "profile": [ "http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/computable-measure-cqfm" ]
      },
      "contained": [ {
