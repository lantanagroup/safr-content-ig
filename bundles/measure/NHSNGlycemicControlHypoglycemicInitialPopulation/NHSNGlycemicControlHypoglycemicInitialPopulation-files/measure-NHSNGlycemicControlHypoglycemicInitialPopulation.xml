            <extension url="name">
               <valueString value="SDE Encounter Locations"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;SDE Encounter Locations&quot;:
	[Encounter] Encounter
  with Encounter.location EncounterLocation
  such that (Global.GetLocation(EncounterLocation.location).type in &quot;CDC Location Codes&quot; 
      or Global.GetLocation(EncounterLocation.location).physicalType in &quot;CDC Location Codes&quot;)
  with &quot;Initial Population&quot; InitialPopulation
  such that start of Encounter.period during InitialPopulation.period
  where Encounter.period during &quot;Measurement Period&quot;"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="7"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
