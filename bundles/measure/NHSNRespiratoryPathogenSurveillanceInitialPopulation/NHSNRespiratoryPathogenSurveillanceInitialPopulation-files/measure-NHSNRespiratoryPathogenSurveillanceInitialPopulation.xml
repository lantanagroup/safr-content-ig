nceInitialPopulation"></valueString></extension><extension url="name"><valueString value="EncounterInpatient"></valueString></extension><extension url="statement"><valueString value="define &quot;EncounterInpatient&quot;:
  [Encounter: &quot;Encounter Inpatient&quot;]
    union [Encounter: class in {&quot;inpatient encounter&quot;, &quot;inpatient acute&quot;, &quot;inpatient non-acute&quot;, &quot;short stay&quot;}]"></valueString></extension><extension url="displaySequence"><valueInteger value="0"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="EncounterObservation"></valueString></extension><extension url="statement"><valueString value="define &quot;EncounterObservation&quot;:
  [Encounter: &quot;Observation Services&quot;]
    union [Encounter: class in {&quot;observation encounter&quot;}]"></valueString></extension><extension url="displaySequence"><valueInteger value="1"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="Qualifying Encounter During Measurement Period"></valueString></extension><extension url="statement"><valueString value="define &quot;Qualifying Encounter During Measurement Period&quot;:
  ( &quot;EncounterInpatient&quot;
  union &quot;EncounterObservation&quot;) QualifyingEncounters
  where QualifyingEncounters.status in {'in-progress', 'finished', 'triaged'}
    and QualifyingEncounters.period overlaps &quot;Measurement Period&quot;"></valueString></extension><extension url="displaySequence"><valueInteger value="2"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="Qualifying Location During Measurement Period"></valueString></extension><extension url="statement"><valueString value="define &quot;Qualifying Location During Measurement Period&quot;:
  [Encounter] Encounters
  where exists(
    Encounters.location EncounterLocation
    where Global.GetLocation(EncounterLocation.location).type in &quot;Inpatient, Emergency, and Observation Locations&quot;
      and EncounterLocation.period overlaps Encounters.period
  )"></valueString></extension><extension url="displaySequence"><valueInteger value="3"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="Inpatient and Observation Encounters that ended within the last twenty four Hours"></valueString></extension><extension url="statement"><valueString value="define &quot;Inpatient and Observation Encounters that ended within the last twenty four Hours&quot;:
  ( &quot;EncounterInpatient&quot;
    union &quot;EncounterObservation&quot;) QualifyingEncounters
      where end of QualifyingEncounters.period during &quot;Measurement Period&quot;"></valueString></extension><extension url="displaySequence"><valueInteger value="4"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="Initial Population"></valueString></extension><extension url="statement"><valueString value="//----------------------------------
// Initial Population
//----------------------------------
define &quot;Initial Population&quot;:
  &quot;Qualifying Encounter During Measurement Period&quot;
  union &quot;Qualifying Location During Measurement Period&quot;
  union &quot;Inpatient and Observation Encounters that ended within the last twenty four Hours&quot;"></valueString></extension><extension url="displaySequence"><valueInteger value="5"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="SDE Location"></valueString></extension><extension url="statement"><valueString value="define &quot;SDE Location&quot;:
  [Location] Locations
  where exists(&quot;Initial Population&quot;)
  return SharedResource.LocationResource(Locations)"></valueString></extension><extension url="displaySequence"><valueInteger value="6"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="SDE Isolation Precautions Implemented"></valueString></extension><extension url="statement"><valueString value="define &quot;SDE Isolation Precautions Implemented&quot;:
  [Procedure: &quot;Transmission Based Precaution Types&quot;] IsolationPrecautions
    where Global.&quot;Normalize Interval&quot;(IsolationPrecautions.performed) during &quot;Measurement Period&quot;
    and exists(&quot;Initial Population&quot;)
  return SharedResource.ProcedureResource(IsolationPrecautions)"></valueString></extension><extension url="displaySequence"><valueInteger value="7"></valueInteger></extension></extension><extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition"><extension url="libraryName"><valueString value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"></valueString></extension><extension url="name"><valueString value="SDE Minimal Patient"></valueString></extension><extension url="statement"><valueString value="//----------------------------------
