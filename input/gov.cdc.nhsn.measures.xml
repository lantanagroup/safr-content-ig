            <name value="NHSNRespiratoryPathogenSurveillanceInitialPopulation"/>
            <description value="Library of NHSN Respiratory Pathogen Surveillance Initial Population Measure"/>
            <groupingId value="libs"/>
        </resource>
        <resource>
            <reference>
                <reference value="Library/NHSNdQMAcuteCareHospitalInitialPopulation"/>
            </reference>
            <name value="NHSNdQMAcuteCareHospitalInitialPopulation"/>
            <description value="Library of NHSN dQM Acute Care Hospital Initial Population Measure"/>
            <groupingId value="libs"/>
        </resource>
        <resource>
            <reference>
                <reference value="Device/cqf-tooling"/>
            </reference>
            <name value="cqf-tooling"/>
            <description value="Device - Software System Example"/>
            <groupingId value="example"/>
        </resource>
        <resource>
            <reference>
                <reference value="Bundle/submission-example1"/>
            </reference>
            <name value="Submission Example 1"/>
            <description value="Measure Bundle - Submission Example 1"/>
            <groupingId value="example"/>
        </resource>
