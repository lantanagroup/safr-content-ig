        <resource>
            <reference>
                <reference value="StructureDefinition/nhsn-measurereport-bundle"/>
            </reference>
            <name value="NHSN Report Bundle"/>
            <description
                value="Profile of the Report Submission (to NHSN) Bundle profile comprised of a Patients of Interest List, a subject-list MeasureReport, and multiple individual MeasureReports."/>
            <groupingId value="submission"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/subjectlist-measurereport"/>
            </reference>
            <name value="Subject-List MeasureReport Profile"/>
            <description
                value="Subject-list MeasureReport Profile is based on the base MeasureReport structure. It contains the List of all Individual MeasureReports that have been evaluated to be included in the Initial Population (IP), the IP count total, and its subjectReults references the aforementioned .contained Individual MeasureReport List."/>
            <groupingId value="submission"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/ip-measurereport-list"/>
            </reference>
            <name value="Individual MasureReport List Profile"/>
            <description
                value="List of all Individual MeasureReports for a given NHSN measure; each individual MR pertians to an individual who has been determined/evaluated to be in the Initial Population"/>
            <groupingId value="submission"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/poi-list"/>
            </reference>
            <name value="Patients of Interest List Profile"/>
            <description
                value="List Profile defining individual Patients being considered for evalautation for NHSN Measure reporting"/>
            <groupingId value="submission"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/cross-measure-patient"/>
            </reference>
            <name value="Cross-Measure Patient"/>
            <description
                value="This is the cross-measure Patient profile requirements for reporting to NHSN for all measures"/>
            <groupingId value="cross-measure"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/hypoglycemic-reporting-encounter"/>
