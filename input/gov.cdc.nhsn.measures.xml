        <resource>
            <reference>
                <reference value="StructureDefinition/link-patient-list-applicable-period-extension"/>
            </reference>
            <name value="Patient List Applicable Period"/>
            <description value="An extension used to indicate the reporting period associated with the census List."/>
            <groupingId value="extensions"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/link-original-resource-id-extension"/>
            </reference>
            <name value="Original Resource Id"/>
            <description value="An extension to store an original {Resource}.id of from a source that was modified by a processing system (e.g. NHSNLink) to make it usable for NHSN. This may occur if the resource id is not valid per the FHIR specification (e.g. the id is more than 64 characters)."/>
            <groupingId value="extensions"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/link-original-element-value-extension"/>
            </reference>
            <name value="Original Element Value"/>
            <description value="An extension to store an original value of an element from a source that was modified by a processing system (e.g. NHSNLink) to make it usable for NHSN. This may include changing logically invalid data, data not matching specification requirements (use sparingly for specific instances only), normalization purposes, or other reasons."/>
            <groupingId value="extensions"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/link-original-mapped-concept-extension"/>
            </reference>
            <name value="Original Mapped Concept"/>
            <description value="An extension used to store an original Concept that was mapped during processing."/>
            <groupingId value="extensions"/>
        </resource>

        <resource>
            <reference>
                <reference value="StructureDefinition/extension-MeasureReport.population.description"/>
            </reference>
            <name value="Measure Report Population Description (R5 surrogate extension)"/>
            <description value="Measure Report Population Description (The definition in the NHSN is a surrogate for the extension. CQF Tooling uses this extension, but is yet unpublished.)"/>
            <groupingId value="extensions"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/extension-MeasureReport.supplementalDataElement.reference"/>
            </reference>
            <name value="Measure Report Supplemental Data Element Reference (R5 surrogate extension)"/>
            <description value="Measure Report Supplemental Data Element Reference (The definition in the NHSN is a surrogate for the extension. CQF Tooling uses this extension, but is yet unpublished.)"/>
            <groupingId value="extensions"/>
        </resource>
        <resource>
            <reference>
                <reference value="StructureDefinition/extension-criteriaReference"/>
            </reference>
            <name value="Measure Report Criteria Reference (R5 surrogate extension)"/>
            <description value="Measure Report Criteria Reference (The definition in the NHSN is a surrogate for the extension. CQF Tooling uses this extension, but is yet unpublished.)"/>
            <groupingId value="extensions"/>
        </resource>


        <page>
            <!-- The root will always be toc.html - the template will force it if you don't do it -->
            <nameUrl value="toc.html"/>
            <title value="Table of Contents"/>
            <generation value="html"/>
            <page>
                <nameUrl value="index.html"/>
                <title value="NHSN Measures"/>
                <generation value="html"/>
            </page>
            <page>
                <nameUrl value="downloads.html"/>
                <title value="Useful Downloads"/>
                <generation value="html"/>
            </page>
            <page>
                <nameUrl value="license.html"/>
                <title value="License"/>
                <generation value="markdown"/>
            </page>
            <page>
                <nameUrl value="changes.html"/>
                <title value="IG Change History"/>
                <generation value="html"/>
            </page>
        </page>
        <!-- copyright year is a mandatory parameter -->
        <parameter>
            <code value="copyrightyear"/>
            <value value="2019+"/>
        </parameter>
        <!-- releaselabel should be the ballot status for HL7-published IGs. -->
        <parameter>
            <code value="releaselabel"/>
            <value value="CI Build"/>
        </parameter>
        <parameter>
            <code value="find-other-resources"/>
            <value value="true"/>
        </parameter>
        <parameter>
            <code value="path-resource"/>
            <value value="input/resources/library"/>
        </parameter>
        <parameter>
            <code value="path-resource"/>
            <value value="input/resources/measure"/>
        </parameter>
        <parameter>
            <code value="path-resource"/>
            <value value="input/resources/codesystem"/>
        </parameter>
        <parameter>
            <code value="path-resource"/>
            <value value="input/resources/valueset"/>
        </parameter>
        <parameter>
            <code value="path-resource"/>
            <value value="input/resources/plandefinition"/>
        </parameter>
        <!-- This parameter indicates to the publisher that it should translate and package CQL libraries. See the example library resources for more -->
        <!-- This is disabled for now because the CQF Tooling has more up-to-date CQL processing than the publisher. Run refresh to update IG resources
    <parameter>
      <code value="path-binary"/>
      <value value="input/cql"/>
    </parameter>
    -->
        <parameter>
            <code value="path-liquid"/>
            <value value="templates/liquid"/>
        </parameter>
        <parameter>
            <code value="path-suppressed-warnings"/>
            <value value="input/ignoreWarnings.txt"/>
        </parameter>
