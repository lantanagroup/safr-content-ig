   <name value="HypoglycemiaSevereEvent"></name>
   <title value="NHSN Glycemic Control, Hypoglycemia Severe Events"></title>
   <date value="2022-02-17T08:35:34-08:00"></date>
   <description value="Metric 1: The proportion of inpatient encounters of adult patients who were administered or have completed orders for at least one antidiabetic drug (ADD) that preceded a severe hypoglycemic event during the encounter."></description>
   <effectivePeriod>
      <start value="2021-01-01"></start>
      <end value="2021-12-31"></end>
   </effectivePeriod>
