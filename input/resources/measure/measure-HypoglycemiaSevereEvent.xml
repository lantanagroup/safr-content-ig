         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="HypoglycemiaSevereEvent"></valueString>
            </extension>
            <extension url="name">
               <valueString value="Initial Population"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;Initial Population&quot;:
	[Encounter] Encounters
    where (
    	Encounters.class ~ &quot;inpatient encounter&quot;
        or Encounters.class ~ &quot;inpatient acute&quot;
        or Encounters.class ~ &quot;inpatient non-acute&quot;
    )
	// &quot;starts during&quot; for encounters that haven't been completed yet (have no Encounter.period.end)
	and Encounters.period starts during &quot;Measurement Period&quot;"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="0"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="HypoglycemiaSevereEvent"></valueString>
            </extension>
            <extension url="name">
               <valueString value="Antidiabetic Drugs Administered or Ordered"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;Antidiabetic Drugs Administered or Ordered&quot;:
	([MedicationAdministration: &quot;NHSN Hypoglycemia Drugs&quot;] ADDMedAdmin
    	where ADDMedAdmin.status ~ 'completed'
	)
	union [MedicationRequest: &quot;NHSN Hypoglycemia Drugs&quot;] ADDMedRequest"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="1"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="HypoglycemiaSevereEvent"></valueString>
            </extension>
            <extension url="name">
               <valueString value="Denominator"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;Denominator&quot;:
	&quot;Initial Population&quot; InitialPopulation
    with &quot;Antidiabetic Drugs Administered or Ordered&quot; ADD
    	such that Coalesce(start of Global.&quot;Normalize Interval&quot;(ADD.effective), ADD.authoredOn)
        	during &quot;HospitalizationWithObservation&quot;(InitialPopulation)
		and &quot;AgeInYearsAt&quot;(start of InitialPopulation.period) &gt;= 18"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="2"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="HypoglycemiaSevereEvent"></valueString>
            </extension>
            <extension url="name">
               <valueString value="Blood Glucose Test Greater Than 80"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;Blood Glucose Test Greater Than 80&quot;:
	[Observation: &quot;Blood Glucose Laboratory Tests&quot;] FollowupBloodGlucoseLab
    where ( FollowupBloodGlucoseLab.status = 'final'
           or FollowupBloodGlucoseLab.status = 'amended'
          )
	and FollowupBloodGlucoseLab.value &gt; 80 'mg/dL'"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="3"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="HypoglycemiaSevereEvent"></valueString>
            </extension>
            <extension url="name">
               <valueString value="First Severe Hypoglycemic Event"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;First Severe Hypoglycemic Event&quot;:
	First([&quot;Observation&quot;: &quot;Blood Glucose Laboratory Tests&quot;] BloodGlucoseLab
    	with &quot;Antidiabetic Drugs Administered or Ordered&quot; ADDMeds
    	such that Coalesce(start of Global.&quot;Normalize Interval&quot;(ADDMeds.effective), ADDMeds.authoredOn) 24 
			hours or less on or before start of Global.&quot;Normalize Interval&quot;(BloodGlucoseLab.effective)
        and (
            BloodGlucoseLab.status = 'final'
            or BloodGlucoseLab.status = 'amended'
        )
        and BloodGlucoseLab.status != 'cancelled'
        and BloodGlucoseLab.value &lt; 40 'mg/dL'
        and not exists &quot;Blood Glucose Test Greater Than 80&quot; FollowupBloodGlucoseLab
            where Global.&quot;Normalize Interval&quot;(FollowupBloodGlucoseLab.effective) starts 
            5 minutes or less after start of Global.&quot;Normalize Interval&quot;(BloodGlucoseLab.effective)
	)"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="4"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="HypoglycemiaSevereEvent"></valueString>
            </extension>
            <extension url="name">
               <valueString value="Numerator"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="define &quot;Numerator&quot;:
	&quot;Denominator&quot; QualifyingEncounter
    with &quot;First Severe Hypoglycemic Event&quot; FirstSevereEvent
    such that Global.&quot;Normalize Interval&quot;(FirstSevereEvent.effective) during QualifyingEncounter.period"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="5"></valueInteger>
            </extension>
         </extension>
