            <extension url="name">
               <valueString value="Initial Population"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="//CDI initial Patient Population: All inpatient, ED, and Observation encounters and short stay during the Measurement Period
//Encounter.hospitalization.dischargeDisposition:CodeableConcept 0..1 no SDE need for this
//Encounter.diagnosis.use:CodeableConcept 0..1 no SDE need for this
define &quot;Initial Population&quot;:
  [Encounter: class in {&quot;inpatient encounter&quot;, &quot;inpatient acute&quot;, &quot;inpatient non-acute&quot;, &quot;emergency&quot;, &quot;observation encounter&quot;, &quot;short stay&quot;}] IPEnc
    where IPEnc.period overlaps &quot;Measurement Period&quot;"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="0"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
            <extension url="libraryName">
               <valueString value="NHSNAntibioticTreatedCDIInitialPopulation"></valueString>
            </extension>
            <extension url="name">
               <valueString value="SDE Encounter Locations"></valueString>
            </extension>
            <extension url="statement">
               <valueString value="//Encounter.location.location:Reference(Location) Location.type indicate type of function performed at the location
//Encounter.location.physicalType is the physical type of the location (usually the level in location hierachy)
//For CDI measure, we want to identify the function performed at the location, such as impatient location
//Each facility may have a map between CDC Location type to facility location, need to see how this play out in CoLab
define &quot;SDE Encounter Locations&quot;:
	[Encounter] Encounter
  with Encounter.location EncounterLocation
  such that (GetLocation(EncounterLocation.location).type in &quot;CDC Location Codes&quot;) 
      //or GetLocation(EncounterLocation.location).physicalType in &quot;CDC Location Codes&quot;)
  with &quot;Initial Population&quot; InitialPopulation
  such that start of Encounter.period during InitialPopulation.period"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="1"></valueInteger>
            </extension>
         </extension>
