   <name value="Initial Inpatient Population"></name>
   <title value="NHSN Glycemic Control, Initial Inpatient Population (Hypoglycemia)"></title>
   <date value="2022-04-08T10:17:26-08:00"></date>
   <description value="All inpatient encounters (including ED/Observation visits that end within 1 hour of the start of the inpatient encounter) for patients of all ages where at least one ADD was ordered or administered during the encounter that is during the performance period."></description>
