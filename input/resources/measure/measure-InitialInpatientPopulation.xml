            <extension url="statement">
               <valueString value="define &quot;Antidiabetic Drugs Administered and Ordered&quot;:
  ([MedicationAdministration: &quot;NHSN Hypoglycemia Drugs&quot;] ADDMedAdmin
    where ADDMedAdmin.status ~ 'completed')
  union [MedicationRequest: &quot;NHSN Hypoglycemia Drugs&quot;]"></valueString>
