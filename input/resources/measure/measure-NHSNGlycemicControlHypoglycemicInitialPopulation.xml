	[MedicationRequest] MedicationRequests
  with &quot;Initial Population&quot; InitialPopulation
	such that MedicationRequests.authoredOn during &quot;HospitalizationWithObservationOrEmergency&quot;(InitialPopulation)
    and MedicationRequests.authoredOn during &quot;Measurement Period&quot;"></valueString>
            </extension>
            <extension url="displaySequence">
               <valueInteger value="4"></valueInteger>
            </extension>
         </extension>
         <extension url="http://hl7.org/fhir/us/cqfmeasures/StructureDefinition/cqfm-logicDefinition">
