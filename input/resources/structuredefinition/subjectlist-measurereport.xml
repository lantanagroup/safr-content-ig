<StructureDefinition
    xmlns="http://hl7.org/fhir">
    <id value="subjectlist-measurereport"/>
    <url value="http://www.cdc.gov/nhsn/fhirportal/dqm/ig/StructureDefinition/subjectlist-measurereport"/>
    <name value="SubjectListMeasureReportProfile"/>
    <title value="Subject-List MeasureReport Profile"/>
    <status value="active"/>
    <fhirVersion value="4.0.1"/>
    <kind value="resource"/>
    <abstract value="false"/>
    <type value="MeasureReport"/>
    <baseDefinition value="http://hl7.org/fhir/StructureDefinition/MeasureReport"/>
    <derivation value="constraint"/>
    <differential>
        <element id="MeasureReport">
            <path value="MeasureReport"/>
        </element>
        <element id="MeasureReport.meta.extension:link-received-date-extension">
            <path value="MeasureReport.meta.extension"/>
            <sliceName value="link-received-date-extension"/>
            <min value="0"/>
            <max value="1"/>
            <type>
                <code value="Extension"/>
                <profile value="http://www.cdc.gov/nhsn/fhirportal/dqm/ig/StructureDefinition/link-received-date-extension"/>
            </type>
        </element>
        <element id="MeasureReport.type">
            <path value="MeasureReport.type"/>
            <type>
                <code value="code"/>
            </type>
            <fixedCode value="subject-list"/>
            <constraint>
                <key value="ele-1"/>
                <severity value="error"/>
                <human value="All FHIR elements must have a @value or children"/>
                <expression value="hasValue() or (children().count() &gt; id.count())"/>
                <xpath value="@value|f:*|h:div"/>
                <source value="http://hl7.org/fhir/StructureDefinition/Element"/>
            </constraint>
            <mustSupport value="true"/>
            <isModifier value="false"/>
            <isSummary value="true"/>
        </element>
        <element id="MeasureReport.group">
            <path value="MeasureReport.group"/>
            <short value="Initial population group"/>
            <min value="1"/>
            <max value="1"/>
            <mustSupport value="true"/>
        </element>
        <element id="MeasureReport.group.population">
            <path value="MeasureReport.group.population"/>
            <short value="Initial population"/>
            <min value="1"/>
            <max value="1"/>
            <mustSupport value="true"/>
        </element>
        <element id="MeasureReport.group.population.code">
            <path value="MeasureReport.group.population.code"/>
            <min value="1"/>
            <patternCodeableConcept>
                <coding>
                    <system value="http://terminology.hl7.org/CodeSystem/measure-population"/>
                    <code value="initial-population"/>
                    <display value="Initial Population"/>
                </coding>
            </patternCodeableConcept>
        </element>
        <element id="MeasureReport.group.population.count">
            <path value="MeasureReport.group.population.count"/>
            <min value="1"/>
        </element>
        <element id="MeasureReport.group.population.subjectResults">
            <path value="MeasureReport.group.population.subjectResults"/>
            <short value="List referencing all individual measure reports for this measure"/>
            <min value="1"/>
            <type>
                <code value="Reference"/>
                <targetProfile value="http://www.cdc.gov/nhsn/fhirportal/dqm/ig/StructureDefinition/ip-measurereport-list"/>
            </type>
        </element>
    </differential>
</StructureDefinition>