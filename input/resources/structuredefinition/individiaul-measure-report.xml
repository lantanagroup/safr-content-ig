<StructureDefinition
    xmlns="http://hl7.org/fhir">
    <id value="individiaul-measure-report"/>
    <url value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/individiaul-measure-report"/>
    <name value="IndividualMeasureReportCurrent"/>
    <title value="Individual Measure Report (Current)"/>
    <status value="active"/>
    <kind value="resource"/>
    <abstract value="false"/>
    <type value="MeasureReport"/>
    <baseDefinition value="http://hl7.org/fhir/StructureDefinition/MeasureReport"/>
    <derivation value="constraint"/>
    <differential>
        <element id="MeasureReport">
            <path value="MeasureReport"/>
        </element>
        <element id="MeasureReport.extension">
            <path value="MeasureReport.extension"/>
            <slicing>
                <discriminator>
                    <type value="value"/>
                    <path value="$this"/>
                </discriminator>
                <ordered value="false"/>
                <rules value="open"/>
            </slicing>
        </element>
        <element id="MeasureReport.extension:population-description">
            <path value="MeasureReport.extension"/>
            <sliceName value="population-description"/>
            <type>
                <code value="Extension"/>
            </type>
        </element>
        <element id="MeasureReport.extension:population-description.url">
            <path value="MeasureReport.extension.url"/>
            <fixedUri value="http://hl7.org/fhir/5.0/StructureDefinition/extension-MeasureReport.population.description"/>
        </element>
        <element id="MeasureReport.extension:population-description.value[x]">
            <path value="MeasureReport.extension.value[x]"/>
            <type>
                <code value="string"/>
            </type>
        </element>
        <element id="MeasureReport.extension:sde-reference">
            <path value="MeasureReport.extension"/>
            <sliceName value="sde-reference"/>
            <type>
                <code value="Extension"/>
            </type>
        </element>
        <element id="MeasureReport.type">
            <path value="MeasureReport.type"/>
            <fixedCode value="individual"/>
        </element>
        <element id="MeasureReport.subject">
            <path value="MeasureReport.subject"/>
            <min value="1"/>
        </element>
        <element id="MeasureReport.date">
            <path value="MeasureReport.date"/>
            <min value="1"/>
        </element>
        <element id="MeasureReport.evaluatedResource.reference">
            <path value="MeasureReport.evaluatedResource.reference"/>
            <min value="1"/>
        </element>
        <element id="MeasureReport.evaluatedResource.extension.url">
            <path value="MeasureReport.evaluatedResource.extension.url"/>
            <fixedUri value="http://hl7.org/fhir/us/davinci-deqm/StructureDefinition/extension-criteriaReference"/>
        </element>
        <element id="MeasureReport.evaluatedResource.extension.value[x]">
            <path value="MeasureReport.evaluatedResource.extension.value[x]"/>
            <type>
                <code value="string"/>
            </type>
        </element>
        <element id="MeasureReport.group.population.extension">
            <path value="MeasureReport.group.population.extension"/>
        </element>
        <element id="MeasureReport.group.population.code">
            <path value="MeasureReport.group.population.code"/>
            <min value="1"/>
            <patternCodeableConcept>
                <coding>
                    <system value="http://terminology.hl7.org/CodeSystem/measure-population"/>
                    <code value="initial-population"/>
                    <display value="Initial Population"/>
                </coding>
            </patternCodeableConcept>
        </element>
        <element id="MeasureReport.group.population.count">
            <path value="MeasureReport.group.population.count"/>
            <min value="1"/>
            <fixedInteger value="1"/>
        </element>
        <element id="MeasureReport.group.population.extension.url">
            <path value="MeasureReport.group.population.extension.url"/>
            <fixedUri value="http://hl7.org/fhir/5.0/StructureDefinition/extension-MeasureReport.population.description"/>
        </element>
        <element id="MeasureReport.group.population.extension.value[x]">
            <path value="MeasureReport.group.population.extension.value[x]"/>
            <type>
                <code value="string"/>
            </type>
        </element>
        <element id="MeasureReport.extension:sde-reference.url">
            <path value="MeasureReport.extension.url"/>
            <fixedUri value="http://hl7.org/fhir/5.0/StructureDefinition/extension-MeasureReport.supplementalDataElement.reference"/>
        </element>
        <element id="MeasureReport.extension:sde-reference.value[x]">
            <path value="MeasureReport.extension.value[x]"/>
            <type>
                <code value="Reference"/>
            </type>
        </element>
    </differential>
</StructureDefinition>