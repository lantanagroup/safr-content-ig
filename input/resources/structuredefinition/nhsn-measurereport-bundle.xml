<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition
    xmlns="http://hl7.org/fhir">
    <id value="nhsn-measurereport-bundle"/>
    <url value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/nhsn-measurereport-bundle"/>
    <name value="NHSNMeasureReportBundleProfileCurrent"/>
    <title value="NHSN MeasureReport Bundle Profile (Current)"/>
    <status value="active"/>
    <fhirVersion value="4.0.1"/>
    <kind value="resource"/>
    <abstract value="false"/>
    <type value="Bundle"/>
    <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Bundle"/>
    <derivation value="constraint"/>
    <differential>
        <element id="Bundle">
            <path value="Bundle"/>
        </element>
        <element id="Bundle.entry">
            <path value="Bundle.entry"/>
            <slicing>
                <discriminator>
                    <type value="profile"/>
                    <path value=".resolve()"/>
                </discriminator>
                <rules value="open"/>
            </slicing>
        </element>
        <!-- POI List -->
        <element id="Bundle.entry:poi-list">
            <path value="Bundle.entry"/>
            <sliceName value="poi-list"/>
            <min value="1"/>
            <max value="1"/>
        </element>
        <element id="Bundle.entry:poi-list.resource">
            <path value="Bundle.entry.resource"/>
            <min value="1"/>
            <type>
                <code value="Resource"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/poi-list"/>
            </type>
        </element>
        <!-- subject-list MR -->
        <element id="Bundle.entry:subject-list">
            <path value="Bundle.entry"/>
            <sliceName value="subject-list"/>
            <min value="1"/>
            <max value="1"/>
        </element>
        <element id="Bundle.entry:subject-list.resource">
            <path value="Bundle.entry.resource"/>
            <min value="1"/>
            <type>
                <code value="Resource"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/subjectlist-measurereport-deqm"/>
            </type>
        </element>
        <!-- indv MRs -->
        <element id="Bundle.entry:individual">
            <path value="Bundle.entry"/>
            <sliceName value="individual"/>
            <mustSupport value="true"/>
        </element>
        <element id="Bundle.entry:individual.resource">
            <path value="Bundle.entry.resource"/>
            <min value="1"/>
            <type>
                <code value="Resource"/>
                <profile value="http://hl7.org/fhir/us/davinci-deqm/StructureDefinition/indv-measurereport-deqm"/>
            </type>
        </element>
    </differential>
</StructureDefinition>