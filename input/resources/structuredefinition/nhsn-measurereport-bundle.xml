        <element id="Bundle.entry:coverage.resource">
            <path value="Bundle.entry.resource"/>
            <min value="1"/>
            <type>
                <code value="Coverage"/>
            </type>
        </element>
        - Clinical -
        <element id="Bundle.entry:clinical">
            <path value="Bundle.entry"/>
            <sliceName value="clinical"/>
            <min value="0"/>
            <max value="*"/>
        </element>
        <element id="Bundle.entry:clinical.resource">
            <path value="Bundle.entry.resource"/>
