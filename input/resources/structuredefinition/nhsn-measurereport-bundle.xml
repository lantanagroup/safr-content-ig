        </element>
        <element id="Bundle.entry:supportive-resources.resource">
            <path value="Bundle.entry.resource"/>
            <min value="1"/>
            <type>
                <code value="Location"/>
            </type>
        </element>-->
    </differential>
</StructureDefinition>