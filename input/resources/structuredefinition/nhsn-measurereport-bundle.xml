<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition
    xmlns="http://hl7.org/fhir">
    <id value="nhsn-measurereport-bundle"/>
    <url value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/nhsn-measurereport-bundle"/>
    <name value="NHSNMeasureReportBundleProfileCurrent"/>
    <title value="NHSN MeasureReport Bundle Profile (Current)"/>
    <status value="active"/>
    <fhirVersion value="4.0.1"/>
    <kind value="resource"/>
    <abstract value="false"/>
    <type value="Bundle"/>
    <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Bundle"/>
    <derivation value="constraint"/>
    <differential>
        <element id="Bundle">
            <path value="Bundle"/>
            <short value="A Bundle contains a collection of Resources"/>
            <constraint>
                <key value="bundle-no-modifier-extensions"/>
                <severity value="error"/>
                <human value="MeasureReport Bundle:  must not contain any modifierExensions"/>
                <expression value="(select(modifierExtension) | descendants().select(modifierExtension)).exists().not()"/>
                <source value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/nhsn-measurereport-bundle"/>
            </constraint>
            <constraint>
                <key value="bundle-contain-all-measurereport-references"/>
                <severity value="error"/>
                <human value="MeasureReport Bundle: must contain all Resources that are references by MeasureReport references"/>
                <expression value="Bundle.entry.resource.where($this.is(MeasureReport)).descendants().reference.where($this.startsWith('#').not()).all((%resource.entry.fullUrl.join('|')&amp;'|').contains(($this&amp;'|')))"/>
                <source value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/nhsn-measurereport-bundle"/>
            </constraint>
        </element>
        <element id="Bundle.entry">
            <path value="Bundle.entry"/>
            <short value="An entry in the Bundle; will have a Resource or information"/>
            <slicing>
                <!--<discriminator>
                    <type value="type"/>
                    <path value="resource"/>
                </discriminator>-->
                <discriminator>
                    <type value="profile"/>
                    <path value="resource"/>
                </discriminator>
                <rules value="open"/>
            </slicing>
        </element>
        <!-- NHSN Submitting Organization -->
        <element id="Bundle.entry:submitting-organization">
            <path value="Bundle.entry"/>
            <sliceName value="submitting-organization"/>
            <short value="The Submitting Organization: the organization that is the source of the data"/>
            <min value="1"/>
            <max value="1"/>
        </element>
        <element id="Bundle.entry:submitting-organization.resource">
            <path value="Bundle.entry.resource"/>
            <short value="Bundle entry for submitting organization"/>
            <min value="1"/>
            <type>
                <code value="Organization"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/nhsn-submitting-organization"/>
            </type>
        </element>
        <!-- POI/Census List -->
        <element id="Bundle.entry:poi-list">
            <path value="Bundle.entry"/>
            <sliceName value="poi-list"/>
            <short value="The Patients of Interest List: a List containing Patient FHIR IDs that may be included in the Initial Population across all measures"/>
            <min value="1"/>
            <max value="1"/>
        </element>
        <element id="Bundle.entry:poi-list.resource">
            <path value="Bundle.entry.resource"/>
            <short value="The Bundle entry for Patients of Interest List"/>
            <min value="1"/>
            <type>
                <code value="List"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/poi-list"/>
            </type>
        </element>
        <!-- subject-list MR -->
        <element id="Bundle.entry:subject-list">
            <path value="Bundle.entry"/>
            <sliceName value="subject-list"/>
            <short value="Summary Measure Report: For each measure, there is one Summary MeasureReport. The Summary MeasureReport includes the population count and a link to the List of Individual MeasureReports that are included in the summary"/>
            <min value="1"/>
            <max value="*"/>
        </element>
        <element id="Bundle.entry:subject-list.resource">
            <path value="Bundle.entry.resource"/>
            <short value="The Bundle entry for a Summary Measure Report"/>
            <type>
                <code value="MeasureReport"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/subjectlist-measurereport"/>
            </type>
        </element>
        <!-- individual-measure-report-list -->
        <element id="Bundle.entry:individual-measure-report-list">
            <path value="Bundle.entry"/>
            <sliceName value="individual-measure-report-list"/>
            <short value="Individual Measure Report List: a list of Individual MeasureReports, each associated with a single Summary Measure Report"/>
        </element>
        <element id="Bundle.entry:individual-measure-report-list.resource">
            <path value="Bundle.entry.resource"/>
            <short value="The Bundle entry for an Individual Measure Report List"/>
            <min value="1"/>
            <type>
                <code value="List"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/ip-measurereport-list"/>
            </type>
        </element>
        <!-- indv MRs -->
        <element id="Bundle.entry:individual-measurereport">
            <path value="Bundle.entry"/>
            <sliceName value="individual-measurereport"/>
            <short value="Individual Measure Report: each Individual MeasureReport refers to one Patient and one measure included in the Individual Measure Report List"/>
        </element>
        <element id="Bundle.entry:individual-measurereport.resource">
            <path value="Bundle.entry.resource"/>
            <short value="The Bundle entry for an Individual Measure Report"/>
            <min value="1"/>
            <type>
                <code value="MeasureReport"/>
                <profile value="http://hl7.org/fhir/us/davinci-deqm/StructureDefinition/indv-measurereport-deqm"/>
            </type>
        </element>
        <!-- Patients -->
        <element id="Bundle.entry:patient">
            <path value="Bundle.entry"/>
            <sliceName value="patient"/>
            <short value="The Patients associated with an Individual MeasureReport"/>
        </element>
        <element id="Bundle.entry:patient.resource">
            <path value="Bundle.entry.resource"/>
            <short value="The Bundle entry for a Patient associated with an Individual Measure Report"/>
            <min value="1"/>
            <type>
                <code value="Patient"/>
                <profile value="http://lantanagroup.com/fhir/nhsn-measures/StructureDefinition/cross-measure-patient"/>
            </type>
        </element>
