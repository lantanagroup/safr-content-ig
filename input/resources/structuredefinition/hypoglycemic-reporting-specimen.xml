<?xml version="1.0" encoding="UTF-8"?>
<StructureDefinition
    xmlns="http://hl7.org/fhir">
    <id value="hypoglycemic-reporting-specimen"/>
    <url value="http://www.cdc.gov/nhsn/fhirportal/dqm/ig/StructureDefinition/hypoglycemic-reporting-specimen"/>
    <name value="HypoglycemicReportingSpecimen"/>
    <title value="Hypoglycemic Reporting Specimen"/>
    <status value="active"/>
    <description value="This profile contains Required and Must Support data elements for reporting blood glucose specimen information to the NHSN Glycemic Control, Hypoglycemia Module. This profile is based on the [HL7 FHIR R4 Specimen Profile v4.0.1](http://hl7.org/fhir/R4/specimen.html)."/>
    <fhirVersion value="4.0.1"/>
    <kind value="resource"/>
    <abstract value="false"/>
    <type value="Specimen"/>
    <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Specimen"/>
    <derivation value="constraint"/>
    <differential>
        <element id="Specimen">
            <path value="Specimen"/>
        </element>
        <element id="Specimen.id">
            <path value="Specimen.id"/>
            <min value="1"/>
        </element>
        <element id="Specimen.meta.extension:link-received-date-extension">
            <path value="Specimen.meta.extension"/>
            <sliceName value="link-received-date-extension"/>
            <min value="0"/>
            <max value="1"/>
            <type>
                <code value="Extension"/>
                <profile value="http://www.cdc.gov/nhsn/fhirportal/dqm/ig/StructureDefinition/link-received-date-extension"/>
            </type>
        </element>
        <element id="Specimen.identifier">
            <path value="Specimen.identifier"/>
            <mustSupport value="true"/>
        </element>
        <element id="Specimen.accessionIdentifier">
            <path value="Specimen.accessionIdentifier"/>
            <mustSupport value="true"/>
        </element>
        <element id="Specimen.type">
            <path value="Specimen.type"/>
            <min value="1"/>
        </element>
        <element id="Specimen.collection">
            <path value="Specimen.collection"/>
            <mustSupport value="true"/>
        </element>
        <element id="Specimen.collection.collected[x]">
            <path value="Specimen.collection.collected[x]"/>
            <min value="1"/>
        </element>
        <element id="Specimen.collection.bodySite">
            <path value="Specimen.collection.bodySite"/>
            <mustSupport value="true"/>
        </element>
    </differential>
</StructureDefinition>