        </element>
        <element id="ServiceRequest.reasonReference">
            <path value="ServiceRequest.reasonReference"/>
            <mustSupport value="true"/>
        </element>
        <element id="ServiceRequest.specimen">
            <path value="ServiceRequest.specimen"/>
            <mustSupport value="true"/>
        </element>
