library NHSNRespiratoryPathogenSurveillanceInitialPopulation version '0.0.001'

using FHIR version '4.0.1'

include FHIRHelpers version '4.0.001' called FHIRHelpers
include SupplementalDataElementsFHIR4 version '2.0.000' called SDE
include MATGlobalCommonFunctionsFHIR4 version '6.1.000' called Global

codesystem "UMLS": 'http://www.nlm.nih.gov/research/umls' 
codesystem "LOINC": 'http://loinc.org' 
codesystem "Diagnosis Role": 'http://terminology.hl7.org/CodeSystem/diagnosis-role' 
codesystem "ActCode": 'http://terminology.hl7.org/CodeSystem/v3-ActCode' 
codesystem "Observation Category": 'http://terminology.hl7.org/CodeSystem/observation-category' 

valueset "Admit Source": 'http://terminology.hl7.org/ValueSet/encounter-admit-source'
valueset "Discharge Disposition": 'http://terminology.hl7.org/ValueSet/encounter-discharge-disposition'
valueset "Emergency Department Visit": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.117.1.7.1.292' 
valueset "Encounter Inpatient": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.666.5.307' 
valueset "Inpatient, Emergency, and Observation Locations": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1046.265' 
valueset "Isolation Precautions": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1046.231' 
valueset "Observation Services": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1111.143' 
valueset "Respiratory Conditions Related to COVID 19": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113762.1.4.1029.376' 
valueset "SARS Coronavirus 2 Lab Tests": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.3616.200.110.102.5056' 
valueset "SARS CoV 2 Vaccines, All": 'http://cts.nlm.nih.gov/fhir/ValueSet/2.16.840.1.113883.3.3616.200.110.102.10000' 

//code "Admit Source": 'C1550339' from "UMLS" display 'Admit Source'
code "body height": '8302-2' from "LOINC" display 'Body Height'
code "Body height": '8302-2' from "LOINC" display 'Body height'
code "body weight": '29463-7' from "LOINC" display 'Body Weight'
code "Body weight": '29463-7' from "LOINC" display 'Body weight'
code "Chief Complaint": 'CC' from "Diagnosis Role" display 'Chief Complaint'
code "Discharge Diagnosis": 'DD' from "Diagnosis Role" display 'Discharge Diagnosis'
//code "Discharge disposition": '77306-9' from "LOINC" display 'Discharge disposition'
//code "emergency": 'EMER' from "ActCode" display 'emergency'
//code "inpatient acute": 'ACUTE' from "ActCode" display 'inpatient acute'
//code "inpatient encounter": 'IMP' from "ActCode" display 'inpatient encounter'
//code "inpatient non-acute": 'NONAC' from "ActCode" display 'inpatient non-acute'
code "laboratory": 'laboratory' from "Observation Category" display 'Laboratory'
//code "observation encounter": 'OBSENC' from "ActCode" display 'observation encounter'
//code "short stay": 'SS' from "ActCode" display 'short stay'

parameter "Measurement Period" default Interval[@2023-01-01T00:00:00.0, @2023-02-01T00:00:00.0)

context Patient

define "Qualifying Encounter During Measurement Period":
  ( [Encounter: "Encounter Inpatient"]
                union [Encounter: "Observation Services"]) QualifyingEncounters
              where QualifyingEncounters.status in {'in-progress', 'finished', 'triaged'}
                and QualifyingEncounters.period ends during "Measurement Period"

define "Qualifying Location During Measurement Period":
  [Encounter] Encounters
                with Encounters.location EncounterLocation
                such that Global.GetLocation(EncounterLocation.location).type in "Inpatient, Emergency, and Observation Locations"
                 and start of EncounterLocation.period during "Measurement Period"

define "Inpatient and Observation Encounters that ended within the last twenty four Hours":
  ( [Encounter: "Encounter Inpatient"]
                union [Encounter: "Observation Services"]) QualifyingEncounters
              where end of QualifyingEncounters.period during "CalendarDayOfOrDayBefore" (end of QualifyingEncounters.period)

define "SDE Chief Complaint":
  "Initial Population" EncounterCC
              with EncounterCC.diagnosis diagnosis
              such that diagnosis.use ~ "Chief Complaint"

define "SDE Condition":
  [Condition] Conditions 
            with "Initial Population" InitialPopulation
            such that Global."Normalize Interval"(Conditions.onset) overlaps InitialPopulation.period
            and Conditions.clinicalStatus ~ Global."active"

define "SDE Encounter with Admit Source":
  "Initial Population" EncounterAdmitSource
            where EncounterAdmitSource.hospitalization.admitSource ~ "Admit Source"

define "SDE Encounter with Discharge Diagnosis":
  "Initial Population" InitialPopulation
              with InitialPopulation.diagnosis EncounterDiagnosis
              such that EncounterDiagnosis.use ~ "Discharge Diagnosis"

define "SDE Encounter Discharge Dispositions":
  "Initial Population" DischargeDispositions 
            where DischargeDispositions.hospitalization.dischargeDisposition ~"Discharge disposition"

define "SDE Encounter Locations":
  "Initial Population" InitialPopulation
            with InitialPopulation.location IntialPopulationLocation
            such that ((Global.GetLocation(IntialPopulationLocation.location).type in "Inpatient, Emergency, and Observation Locations"
              or Global.GetLocation(IntialPopulationLocation.location).physicalType in "Inpatient, Emergency, and Observation Locations")
              and IntialPopulationLocation.period during "Measurement Period")

define "SDE Immunization History":
  [Immunization: "SARS CoV 2 Vaccines, All"] Immunizations
           with "Initial Population" InitialPopulation 
              such that Immunizations.occurrence before or on start of InitialPopulation.period

define "SDE Location":
  [Location] Location
            where exists("Initial Population")

define "SDE Medication Administration":
  [MedicationAdministration] MedicationAdministration
            with "Initial Population" InitialPopulation
            such that Global."Normalize Interval"(MedicationAdministration.effective) during InitialPopulation.period

define "SDE Medication Request":
  [MedicationRequest] MedicationRequest
              with "Initial Population" InitialPopulation 
              such that Global."Normalize Interval"(MedicationRequest.authoredOn) during InitialPopulation.period

define "SDE Observation Respiratory Infection Test":
  [Observation: "SARS Coronavirus 2 Lab Tests"] SARSLab
              with "Initial Population" InitialPopulation
             such that start of Global."Normalize Interval"(SARSLab.effective) during InitialPopulation.period
              or Global."Normalize Interval"(GetSpecimen(SARSLab.specimen).collection.collected) during InitialPopulation.period
            with SARSLab.category Category
            such that Category ~ "laboratory"

define "SDE SARS Diagnostic Report":
  [DiagnosticReport: "SARS Coronavirus 2 Lab Tests"] SARSDiagnosticReport 
              with "Initial Population" InitialPopulation
              such that Global."Normalize Interval"(SARSDiagnosticReport.effective) during InitialPopulation.period
                and SARSDiagnosticReport.status in {'final'}

define "SDE SARS External Testing":
  [DocumentReference:"SARS Coronavirus 2 Lab Tests"]ExternalTest
           with "Initial Population" InitialPopulation
           such that ExternalTest.date 14 days or less on or before start of InitialPopulation.period
          //influenza and covid, RSV 8 days

define "SDE Payer":
  SDE."SDE Payer" Payer
            with "Initial Population" InitialPopulation
            such that start of Payer.period before end of InitialPopulation.period

define "SDE SARS Coronavirus 2 Lab Tests Order":
  [ServiceRequest: "SARS Coronavirus 2 Lab Tests"] SARSTestOrder
            with "Initial Population" InitialPopulation
            such that (SARSTestOrder.intent ~ 'order'
              and SARSTestOrder.status ~ 'completed')
              and SARSTestOrder.authoredOn during InitialPopulation.period

define "SDE Isolation Precautions Implemented":
  [Procedure: "Isolation Precautions"]IsolationPrecautions
    with "Initial Population" InitialPopulation
   such that Global."Normalize Interval"(IsolationPrecautions.performed) during InitialPopulation.period

define "Initial Population":
  "Qualifying Encounter During Measurement Period"
    union "Qualifying Location During Measurement Period"
    union "Inpatient and Observation Encounters that ended within the last twenty four Hours"

define function "GetSpecimen"(reference Reference ):
  singleton from (
    [Specimen] S where S.id = Global.GetId(reference.reference)
  )

define function "CalendarDayOfOrDayBefore"(StartValue DateTime ):
  Interval["TruncateTime"( StartValue ), "TruncateTime"( StartValue - 1 days ) )

define function "TruncateTime"(Value DateTime ):
  DateTime(year from Value, month from Value, day from Value, 0, 0, 0, 0, timezoneoffset from Value)

